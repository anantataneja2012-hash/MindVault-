
<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 1600 1000"
     preserveAspectRatio="xMidYMid slice">

  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#263b3a"/>
      <stop offset="55%" stop-color="#81918a"/>
      <stop offset="100%" stop-color="#d0cfc1"/>
    </linearGradient>

    <linearGradient id="lake" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#73867e"/>
      <stop offset="100%" stop-color="#182b2c"/>
    </linearGradient>

    <linearGradient id="mist" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f0eee2" stop-opacity="0"/>
      <stop offset="100%" stop-color="#f0eee2" stop-opacity=".65"/>
    </linearGradient>

    <filter id="blur">
      <feGaussianBlur stdDeviation="28"/>
    </filter>

    <linearGradient id="overlay" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#101c1c" stop-opacity=".42"/>
      <stop offset="50%" stop-color="#101c1c" stop-opacity=".08"/>
      <stop offset="100%" stop-color="#101c1c" stop-opacity=".55"/>
    </linearGradient>
  </defs>

  <!-- Sky -->
  <rect width="1600" height="1000" fill="url(#sky)"/>

  <!-- Distant mountain silhouettes -->
  <path d="M0 470 L170 330 L310 420 L510 245
           L690 430 L900 260 L1080 420
           L1280 285 L1450 410 L1600 300
           L1600 650 L0 650 Z"
        fill="#536b67"/>

  <path d="M0 520 L220 400 L400 490 L650 350
           L820 490 L1080 365 L1280 480
           L1450 380 L1600 470
           L1600 690 L0 690 Z"
        fill="#344f4c"/>

  <!-- Snow and mountain highlights -->
  <path d="M510 245 L570 320 L530 304 L490 340
           L470 305 Z"
        fill="#e2e1d6" opacity=".65"/>

  <path d="M900 260 L960 340 L915 318 L870 360
           L845 320 Z"
        fill="#e4e1d5" opacity=".55"/>

  <path d="M1280 285 L1335 355 L1290 340
           L1250 375 L1230 340 Z"
        fill="#dedfd3" opacity=".5"/>

  <!-- Forest silhouette -->
  <path d="M0 570 Q180 510 340 570
           Q520 500 720 575
           Q900 520 1100 570
           Q1320 500 1600 575
           L1600 680 L0 680 Z"
        fill="#263f3a"/>

  <!-- Lake -->
  <rect x="0" y="625" width="1600" height="375"
        fill="url(#lake)"/>

  <!-- Distant reflection -->
  <path d="M0 635 Q300 650 600 635
           T1200 640 T1600 630"
        stroke="#d5d7ca" stroke-opacity=".25"
        stroke-width="5" fill="none"/>

  <!-- Water reflections -->
  <g stroke="#c2c7b8" fill="none" opacity=".18">
    <path d="M180 700 Q420 690 650 705" stroke-width="3"/>
    <path d="M850 740 Q1120 725 1420 745" stroke-width="2"/>
    <path d="M300 810 Q620 800 950 815" stroke-width="3"/>
    <path d="M100 900 Q430 890 700 905" stroke-width="2"/>
    <path d="M1000 940 Q1260 925 1530 945" stroke-width="3"/>
  </g>

  <!-- Atmospheric mist -->
  <ellipse cx="800" cy="610" rx="900" ry="100"
           fill="#e5e4d9" opacity=".25" filter="url(#blur)"/>

  <rect width="1600" height="1000" fill="url(#mist)"/>

  <!-- Dark cinematic overlay -->
  <rect width="1600" height="1000" fill="url(#overlay)"/>

</svg>
